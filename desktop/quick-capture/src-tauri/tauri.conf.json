{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobApply Capture",
  "version": "0.1.0",
  "identifier": "com.jobapply.capture",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "capture", "title": "JobApply Capture", "width": 560, "height": 620, "minWidth": 360, "minHeight": 480, "center": true, "resizable": true }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://*.supabase.co; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
