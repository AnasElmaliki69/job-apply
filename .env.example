NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
# Optional local CV import: put CV text in private/master-cv.txt and set its owner.
MASTER_CV_OWNER_EMAIL=your-email@example.com

# Explore offers: server-only Adzuna credentials (France listings).
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Optional Projects → GitHub activity (server-only; never NEXT_PUBLIC_).
# See docs/github-project-activity.md for registering a GitHub App.
GITHUB_APP_ID=your-numeric-app-id
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_APP_ORIGIN=http://localhost:3000
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GITHUB_CREDENTIALS_KEY=your-random-64-character-hex-key
